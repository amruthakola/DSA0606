library(quantmod)
library(ggplot2)

# Download Reliance Industries data from Yahoo Finance
getSymbols("RELIANCE.NS",
           src = "yahoo",
           from = Sys.Date() - 365,
           to = Sys.Date())

# Convert to data frame
reliance_data <- data.frame(
  Date = index(RELIANCE.NS),
  Close = as.numeric(Cl(RELIANCE.NS))
)

# Display first few rows
head(reliance_data)

# Display last few rows
tail(reliance_data)
# Make sure Date is in Date format
reliance_data$Date <- as.Date(reliance_data$Date)

# -------------------------------
# 1. LAST 3 TRADING DAYS
# -------------------------------

data_3days <- tail(reliance_data, 3)

ggplot(data_3days, aes(x = Date, y = Close)) +
  geom_line(linewidth = 1) +
  geom_point(size = 3) +
  labs(
    title = "Reliance Industries - Last 3 Trading Days",
    x = "Date",
    y = "Closing Price (₹)"
  ) +
  theme_minimal()


